<!DOCTYPE html>
<html lang="{{ lang or 'es' }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    {# TÍTULO DINÁMICO #}
    <title>{% if title %}{{ title }} | CAPI Samaipata{% else %}CAPI - Centro Artístico Pedagógico Integral{% endif %}</title>

    {# DESCRIPCIÓN DINÁMICA #}
    <meta name="description" content="{{ description | default('Centro Artístico Pedagógico Integral en Samaipata. Un espacio dedicado al bienestar emocional, apoyo pedagógico y formación artística.') }}" />

    {# CANONICAL URL (NUEVO) #}
    <link rel="canonical" href="https://www.capisamaipata.org{{ page.url }}" />

    <meta name="keywords" content="CAPI Samaipata, centro cultural Bolivia, apoyo pedagógico, clases de música, artes plásticas, formación integral, bienestar emocional jóvenes" />
    <meta name="author" content="CAPI Samaipata" />

    {# OPEN GRAPH DINÁMICO #}
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.capisamaipata.org{{ page.url }}" />
    <meta property="og:title" content="{% if title %}{{ title }} | CAPI{% else %}CAPI - Centro Artístico Pedagógico Integral{% endif %}" />
    <meta property="og:description" content="{{ description | default('Un refugio para el talento en Samaipata. Formación en arte, música y apoyo escolar.') }}" />
    <meta property="og:image" content="https://www.capisamaipata.org/{{ og_image | default('assets/img/og-image.jpg') }}" />

    {# TWITTER CARDS #}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content="{% if title %}{{ title }}{% else %}C.A.P.I. Samaipata{% endif %}" />
    <meta property="twitter:description" content="{{ description | default('Formando talentos, proyectando futuros. Espacio autónomo de dinamización cultural.') }}" />
    <meta property="twitter:image" content="https://www.capisamaipata.org/{{ og_image | default('assets/img/og-image.jpg') }}" />

    <link rel="icon" href="/assets/icon/capi_icon.png" />
    
    {# PRECONNECT PARA FUENTES #}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    {# PRELOAD DEL HERO (CORREGIDO) #}
    {% if hero_image %}
      <link rel="preload" as="image" href="{{ hero_image }}" fetchpriority="high" />
    {% endif %}
    
    {# CSS #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" media="print" onload="this.media='all'" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Open+Sans:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/main.css" />
    
    {# STRUCTURED DATA (NUEVO) #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "CAPI Samaipata",
      "alternateName": "Centro Artístico Pedagógico Integral",
      "url": "https://www.capisamaipata.org",
      "logo": "https://www.capisamaipata.org/assets/img/capi.png",
      "description": "Centro Artístico Pedagógico Integral en Samaipata, Bolivia. Formación en arte, música y apoyo escolar.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Calle Bolívar al lado del Museo",
        "addressLocality": "Samaipata",
        "addressCountry": "BO"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+591-6784-7027",
        "contactType": "customer service",
        "email": "info@capisamaipata.org"
      },
      "sameAs": [
        "https://www.facebook.com/profile.php?id=100078096283586",
        "https://www.instagram.com/capi_samaipata/"
      ]
    }
    </script>
</head>

  <body class="{% if translationKey == 'home' %}home{% endif %}">
    {% if not isErrorPage %}
    <header>
      {# --- NAVBAR --- #}
      <nav class="navbar">
        <div class="container navbar__wrapper">
          <div class="logo">
            <a href="{{ navigation[lang].inicio_url }}">
              <img src="/assets/img/capi.png" alt="Logo de CAPI" />
            </a>
          </div>

          <input type="checkbox" id="menu-check" class="navbar__check" />

          <label for="menu-check" class="navbar__burger">
            <i class="fa-solid fa-bars burger-open"></i>
            <i class="fa-solid fa-xmark burger-close"></i>
          </label>

          <ul class="navbar__links">
            <li>
              <a
                href="{{ navigation[lang].inicio_url }}"
                class="{% if page.url == navigation[lang].inicio_url or page.url == navigation[lang].inicio_url + 'index.html' %}is-active{% endif %}"
              >
                {{ navigation[lang].inicio_label }}
              </a>
            </li>

            <li>
              <a
                href="{{ navigation[lang].nosotros_url }}"
                class="{% if page.url == navigation[lang].nosotros_url %}is-active{% endif %}"
              >
                {{ navigation[lang].nosotros_label }}
              </a>
            </li>

            <li>
              <a
                href="{{ navigation[lang].programas_url }}"
                class="{% if page.url == navigation[lang].programas_url %}is-active{% endif %}"
              >
                {{ navigation[lang].programas_label }}
              </a>
            </li>

            <li>
              <a
                href="{{ navigation[lang].galeria_url }}"
                class="{% if page.url == navigation[lang].galeria_url %}is-active{% endif %}"
              >
                {{ navigation[lang].galeria_label }}
              </a>
            </li>

            <li>
              <a
                href="{{ navigation[lang].contacto_url }}"
                class="{% if page.url == navigation[lang].contacto_url %}is-active{% endif %}"
              >
                {{ navigation[lang].contacto_label }}
              </a>
            </li>
            <li>
              <a 
                href="{{ navigation[lang].donar_url }}" 
                class="btn-donar {% if page.url == navigation[lang].donar_url %}is-active{% endif %}"
              >
                <i class="fas fa-heart"></i>
                {{ navigation[lang].donar_label }}
    
              </a>
          </li>
          </ul>

          <div class="navbar__lang">
  {# --- BOTÓN ESPAÑOL --- #}
  {% if lang == 'es' %}
    {# Si ya estoy en español, solo muestro el texto activo #}
    <span class="lang-link is-active">ES</span>
  {% else %}
    {# Si estoy en inglés, busco la versión española de esta misma página #}
    {% for item in collections.all %}
      {% if item.data.translationKey == translationKey and item.data.lang == 'es' %}
        <a href="{{ item.url }}" class="lang-link">ES</a>
      {% endif %}
    {% endfor %}
  {% endif %}

  <span class="lang-divider">|</span>

  {# --- BOTÓN INGLÉS --- #}
  {% if lang == 'en' %}
    {# Si ya estoy en inglés, solo muestro el texto activo #}
    <span class="lang-link is-active">EN</span>
  {% else %}
    {# Si estoy en español, busco la versión inglesa de esta misma página #}
    {% for item in collections.all %}
      {% if item.data.translationKey == translationKey and item.data.lang == 'en' %}
        <a href="{{ item.url }}" class="lang-link">EN</a>
      {% endif %}
    {% endfor %}
  {% endif %}
</div>
        </div>
      </nav>
    </header>
    {% endif %}
    

    <main>{{ content | safe }}</main>

    {# --- FOOTER --- #}
    {% if not isErrorPage %}
    <footer class="footer">
      <div class="container">
        <div class="footer__wrapper">
          <div class="footer__column">
            <a href="{{ navigation[lang].inicio_url }}">
              <img
                src="/assets/img/capi_footer.png"
                alt="Logo de CAPI"
                class="footer__logo"
              />
            </a>
            <p class="footer__tagline">
              {{ navigation[lang].f_tagline }}
            </p>
          </div>

          <div class="footer__column">
            <h4 class="footer__title">{{ navigation[lang].f_col1_title }}</h4>
            <ul class="footer__links">
              <li>
                <a href="{{ navigation[lang].nosotros_url }}">{{ navigation[lang].nosotros }}</a>
              </li>
              <li>
                <a href="{{ navigation[lang].programas_url }}">{{ navigation[lang].programas }}</a>
              </li>
              <li>
                <a href="{{ navigation[lang].contacto_url }}">{{ navigation[lang].contacto }}</a>
              </li>
              <li>
                <a href="{{ navigation[lang].voluntariado_url }}">{{ navigation[lang].voluntariado_label }}</a>
              </li>
              <li>
                <a href="{{ navigation[lang].donar_url }}">{{ navigation[lang].donar }}</a>
              </li>
            </ul>
          </div>

          <div class="footer__column">
            <h4 class="footer__title">{{ navigation[lang].f_col2_title }}</h4>
            <ul class="footer__contact">
              <li class="footer__contact-item footer__contact-item--address">
                <i class="fa-solid fa-location-dot"></i> {{
                navigation[lang].f_address }}
              </li>
              <li class="footer__contact-item">
                <i class="fa-solid fa-phone"></i> <a href="https://wa.me/59167847027" target="_blank" rel="noopener noreferrer">+591 6784 7027</a></li>
              <li class="footer__contact-item">
                <i class="fa-solid fa-envelope"></i><a href="mailto:info@capisamaipata.org" target="_blank" rel="noopener noreferrer">info@capisamaipata.org</a>
              </li>
            </ul>
          </div>

          <div class="footer__column">
            <h4 class="footer__title">{{ navigation[lang].f_col3_title }}</h4>
            <div class="footer__social">
              <a 
                href="https://www.facebook.com/profile.php?id=100078096283586&sk=about&locale=es_LA" 
                target="_blank" 
                rel="noopener noreferrer"
                aria-label="Síguenos en Facebook"
              >
                <i class="fa-brands fa-facebook-f"></i>
              </a>
              <a 
                href="https://www.instagram.com/capi_samaipata/" 
                target="_blank" 
                rel="noopener noreferrer"
                aria-label="Síguenos en Instagram"
              >
                <i class="fa-brands fa-instagram"></i>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="footer__bottom">
      <div class="container">
        <div class="footer__bottom-content">
          <p>&copy; 2026 CAPI - {{ navigation[lang].f_rights }}</p>
          <div class="footer__legal">
            <a href="{{ navigation[lang].f_privacy_url }}">{{ navigation[lang].f_privacy }}</a>
            <span>|</span>
            <a href="{{ navigation[lang].f_terms_url }}">{{ navigation[lang].f_terms }}</a>
          </div>
        </div>
      </div>
    </div>
      <button class="footer__scroll-top" aria-label="Volver arriba">
        <i class="fa-solid fa-arrow-up"></i>
      </button>
    </footer>
    {% endif %}
    <div id="lightbox" class="lightbox">
      <span class="lightbox__close">&times;</span>
      <img id="lightbox-img" src="" alt="Vista ampliada" />
      <div id="lightbox-caption" class="lightbox__caption"></div>
      <div id="lightbox-counter" class="lightbox__counter"></div>
      <button class="lightbox-nav prev">&lt;</button>
      <button class="lightbox-nav next">&gt;</button>
    </div>
    <script src="/js/main.js" defer></script>
  </body>
</html>
