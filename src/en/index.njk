<section class="contacto">
    <div class="container">
        <div class="contacto__wrapper">
            <div class="contacto__info">
                <h2 class="contacto__title">Any questions?</h2>
                <p class="contacto__text">Leave us your details and we will get back to you as soon as possible to provide guidance about our programs.</p>
                <ul class="contacto__list">
                    <li><i class="fa-solid fa-check"></i> Personalized attention</li>
                    <li><i class="fa-solid fa-check"></i> Guided center tours</li>
                    <li><i class="fa-solid fa-check"></i> Scholarship information</li>
                </ul>
            </div>

            <form 
                class="form"
                name="contacto-capi"
                method="POST"
                data-netlify="true"
                aria-labelledby="form-home-title"
            >
                <h2 id="form-home-title" class="sr-only">Quick Contact Form</h2>
                <input type="hidden" name="form-name" value="contacto-capi" />

                <!-- 🐝 Honeypot Antispam -->
                    <p class="honeypot" style="display: none;">
                        <label>Are you a robot? <input name="botfield" /></label>
                    </p>
                <div class="form__group">
                    <input 
                        type="text" 
                        name="nombre"
                        placeholder="Full name" 
                        class="form__input" 
                        required>
                </div>
                <div class="form__group">
                    <input 
                        type="email"
                        name="email"
                        placeholder="Email address"
                        class="form__input"
                        required
                    >
                </div>
                <div class="form__group">
                    <textarea 
                        name="mensaje"
                        placeholder="How can we help you?" 
                        class="form__input form__input--textarea"
                        required
                    ></textarea>
                </div>
                <button type="submit" class="btn btn--primary form__button">Send Message</button>
            </form>
        </div>
    </div>
</section>